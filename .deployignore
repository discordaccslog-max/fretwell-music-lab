# Files/directories that must NEVER be synced from the GitHub repo to the live
# Cloudways server. Server-managed, server-side, or build-only — leave alone.

# Repo metadata
.git/
.github/
.gitignore
.deployignore

# Node / build tools (storefront is static; builds happen locally for dev)
node_modules/
scripts/
tests/
package.json
package-lock.json

# Vercel config (not used — Fretwell runs on Cloudways)
vercel.json
.vercel/

# Markdown docs — not for the live site
README.md
*.md

# === Server-side / Muadata-relay files — DO NOT DEPLOY ===
# These live only on Cloudways and are hand-managed. Letting GitHub overwrite
# them would break the Muadata routing, expose credentials, or wipe orders.
security_gateway/
.private_data/
order-success/
order-failed/
buy/.credentials.php
buy/.credentials.example.php
buy/process.php
buy/products.php
.env.php
.env
_backups/

# Local dev scratch
fulfillment-kit/
